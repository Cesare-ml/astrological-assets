{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Cesare-ml/astrological-assets/main/schemas/asset-agent-review-results-v1.schema.json",
  "title": "VirgoStars asset agent review result batch v1",
  "description": "Read-only, self-reported per-shard review results. Not an authorization, lease, attestation or public asset license.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "purpose",
    "source",
    "manifestSha256",
    "shardCount",
    "submissions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "purpose": {
      "const": "asset-agent-review-results"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "manifestSha256": {
      "$ref": "#/$defs/sha256"
    },
    "shardCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "submissions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/submission"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "assetRoot"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "\\S"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "assetRoot": {
          "const": "public/assets"
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "opaqueId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "description": "Opaque nonsecret identifier; never use a personal name, email, credential, or private ledger path."
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "finding"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Exact original-case asset path from the pinned worklist; runtime must verify membership."
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "finding": {
          "enum": [
            "inspected",
            "flagged",
            "not-checked"
          ],
          "description": "Agent assertion only; not proof that binary bytes, image rights or visual QA were independently verified."
        }
      }
    },
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shardIndex",
        "assignmentId",
        "agentId",
        "results"
      ],
      "properties": {
        "shardIndex": {
          "type": "integer",
          "minimum": 1
        },
        "assignmentId": {
          "$ref": "#/$defs/opaqueId"
        },
        "agentId": {
          "$ref": "#/$defs/opaqueId"
        },
        "results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/finding"
          }
        }
      }
    }
  }
}
